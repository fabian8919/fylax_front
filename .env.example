# Configuración de entorno (nunca commitear el .env real)
# Se inyecta vía dart-define o --flavor (dev/staging/prod — PRD §12 Fase 1)

# URL del backend FastAPI desplegado en Cloud Run
API_BASE_URL=https://api-dev.fylax.app

# Proyecto Supabase (Auth + PostgreSQL — PRD §4)
SUPABASE_URL=https://<project-ref>.supabase.co
# Anon key (pública, segura para el cliente; RLS protege los datos)
SUPABASE_ANON_KEY=<supabase-anon-key>

# DSN de Sentry para el monitoreo móvil (PRD §4)
SENTRY_DSN=<sentry-dsn>
